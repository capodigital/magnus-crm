# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASEPATH=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/magnus_crm

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_me_with_a_long_random_secret
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me

# -----------------------------------------------------------------------------
# Meta WhatsApp / Embedded Signup
# -----------------------------------------------------------------------------
META_APP_ID=replace_me
# Public app identifier used only to initialize the Facebook JS SDK in the browser.
NEXT_PUBLIC_META_APP_ID=replace_me
META_APP_SECRET=replace_me
META_VERIFY_TOKEN=replace_me
# Server-only token with whatsapp_business_messaging permission. Never use NEXT_PUBLIC_ prefix.
META_ACCESS_TOKEN=replace_me
# Optional provider System User token used after Embedded Signup to attach the provider user to client WABAs.
META_SYSTEM_USER_ACCESS_TOKEN=
# Optional provider System User ID used for the assigned_users onboarding step.
META_SYSTEM_USER_ID=
META_BUSINESS_ACCOUNT_ID=replace_me
META_WABA_ID=replace_me
META_PHONE_NUMBER_ID=replace_me
WHATSAPP_TENANT_SLUG=acme
WHATSAPP_DISPLAY_PHONE_NUMBER=
WHATSAPP_VERIFIED_NAME=
WHATSAPP_QUALITY_RATING=
WHATSAPP_CODE_VERIFICATION_STATUS=
META_GRAPH_API_VERSION=v26.0
NEXT_PUBLIC_META_GRAPH_API_VERSION=v26.0
# Embedded Signup config created in Meta for WhatsApp Business App Onboarding v4.
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=replace_me
# Optional solution ID if Meta assigns one to the Tech Provider configuration.
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_SOLUTION_ID=
# Base64-encoded 32-byte key used to encrypt tenant WhatsApp access tokens at rest.
META_ENCRYPTION_KEY=replace_me_with_32_byte_base64_key

# -----------------------------------------------------------------------------
# Workspace bootstrap
# -----------------------------------------------------------------------------
BOOTSTRAP_TENANT_SLUG=acme
BOOTSTRAP_TENANT_NAME=Acme CRM
BOOTSTRAP_OWNER_EMAIL=owner@acme.com
BOOTSTRAP_OWNER_NAME=Acme Owner
BOOTSTRAP_OWNER_PASSWORD=
# Leave empty to keep the workspace on the main app domain for now.
BOOTSTRAP_DOMAIN_HOST=
BOOTSTRAP_PIPELINE_NAME=Pipeline comercial
BOOTSTRAP_SUPPORT_EMAIL=
BOOTSTRAP_TENANT_LOCALE=es-419
BOOTSTRAP_TENANT_TIMEZONE=America/Havana
